# Local bootstrap only. TerraMig forces this password to be changed after login.
TERRAMIG_ADMIN_USERNAME=admin
TERRAMIG_ADMIN_PASSWORD=admin

# Change this before exposing PostgreSQL outside a developer workstation.
TERRAMIG_POSTGRES_PASSWORD=replace-with-a-random-password
TERRAMIG_PORT=8080
TERRAMIG_SECURE_COOKIES=false

TERRAMIG_HCP_HOSTNAME=app.terraform.io
TERRAMIG_HCP_ORGANIZATION=
TERRAMIG_HCP_WORKSPACE=
# Optional deployment-managed token. It can instead be saved encrypted and
# verified from Configuration in the UI.
TERRAMIG_HCP_TOKEN=
TERRAMIG_GCP_PROJECT_ID=
# Optional deployment-managed ADC JSON. Prefer Configuration in the UI for
# multiline credential material, or mount a file and set
# GOOGLE_APPLICATION_CREDENTIALS in a custom deployment.
TERRAMIG_GCP_CREDENTIALS_JSON=
# Per-command Cloud Asset deadline. Increase for unusually large projects.
TERRAMIG_GCP_DISCOVERY_TIMEOUT_SECONDS=600
TERRAMIG_AI_PROVIDER=github-copilot
# High-scale composition partitions the dependency-ordered inventory before
# invoking Bob or Copilot. Defaults suit large projects without oversized prompts.
TERRAMIG_AI_BATCH_SIZE=20
TERRAMIG_AI_MAX_BATCH_PROMPT_BYTES=120000
TERRAMIG_AI_BATCH_PROCESS_ATTEMPTS=2
# Optional deployment-managed credentials. They can instead be saved encrypted
# from Configuration in the UI.
COPILOT_GITHUB_TOKEN=
BOBSHELL_API_KEY=
# Optional Fernet key for external key management. When empty, TerraMig creates
# /app/.terramig/secret.key with mode 0600 in the persistent runtime volume.
TERRAMIG_SECRET_ENCRYPTION_KEY=
# Initial default for new installations; the Configuration UI persists this setting.
TERRAMIG_ENABLE_HCP_SUBMISSION=true
TERRAMIG_GITHUB_TOKEN=
# Optional deployment-managed, non-passphrase-protected deploy key. Prefer the
# encrypted Configuration UI for multiline private-key material.
TERRAMIG_GIT_SSH_PRIVATE_KEY=
# Custom Git servers require explicitly trusted OpenSSH known_hosts entries.
# GitHub.com host keys are bundled from GitHub's official publication.
TERRAMIG_GIT_KNOWN_HOSTS=
TERRAMIG_GIT_KNOWN_HOSTS_FILE=
TERRAMIG_GIT_ALLOWED_HOSTS=github.com
TERRAMIG_GIT_AUTHOR_NAME=TerraMig
TERRAMIG_GIT_AUTHOR_EMAIL=terramig@localhost
TERRAMIG_HCP_POLL_SECONDS=10
